
# VideoDB Integration
VIDEO_DB_API_KEY=

# Database
DB_TYPE=  # postgres or sqlite

    # PostgreSQL Configuration (required if DB_TYPE=postgres)
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_HOST=
POSTGRES_PORT=

    # SQLite Configuration (required if DB_TYPE=sqlite)
SQLITE_DB_PATH=

# LLM Integrations
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLEAI_API_KEY=

# Skills
# Folder of Agent Skills (<name>/SKILL.md). Re-read on every message.
# Director needs the VideoDB skill: npx skills add video-db/skills --skill videodb -g -y
SKILLS_DIR=~/.agents/skills

# Sandbox for the code_executor and bash_executor tools
# local (default): runs on this machine with your installed tools, no isolation.
# modal: remote containers. pip install modal, then set MODAL_TOKEN_ID/MODAL_TOKEN_SECRET
#   or run `modal setup`. MODAL_IMAGE must already contain your skills at
#   MODAL_SKILLS_DIR; Director does not copy them in.
# none: turns code, bash and skills off.
SANDBOX_PROVIDER=local
MODAL_IMAGE=
MODAL_SKILLS_DIR=/root/.agents/skills

# Devzery API Test
DEVZERY_API_KEY=
DEVZERY_SOURCE_NAME=