
# VideoDB Integration
VIDEO_DB_API_KEY=

# Server
# The API has no authentication. It listens on 127.0.0.1 unless SERVER_HOST is set.
# SERVER_HOST=127.0.0.1
# Comma separated browser origins allowed to call the API and the chat socket.
# Empty allows pages served from localhost on any port.
SERVER_ALLOWED_ORIGINS=

# Database
DB_TYPE=  # postgres or sqlite

    # PostgreSQL Configuration (required if DB_TYPE=postgres)
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_HOST=
POSTGRES_PORT=

    # SQLite Configuration (required if DB_TYPE=sqlite)
SQLITE_DB_PATH=

# LLM Integrations
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLEAI_API_KEY=

# Skills
# Folder of Agent Skills (<name>/SKILL.md). Re-read on every message.
# Director needs the VideoDB skill: npx skills add video-db/skills --skill videodb -g -y
SKILLS_DIR=~/.agents/skills
# Command the Skills page runs to search, preview and install skills (default: npx --yes skills).
SKILLS_CLI=
# Installing skills from the web page is off when SERVER_HOST isn't loopback; 1 allows it.
DIRECTOR_SKILLS_MANAGE=

# Sandbox for the code_executor and bash_executor tools
# local (default): runs on this machine with your installed tools. Sandboxed with
#   Seatbelt on macOS or bubblewrap on Linux (apt install bubblewrap) when available.
# modal: remote containers. pip install modal, then set MODAL_TOKEN_ID/MODAL_TOKEN_SECRET
#   or run `modal setup`. MODAL_IMAGE must already contain your skills at
#   MODAL_SKILLS_DIR; Director does not copy them in.
# none: turns code, bash and skills off.
SANDBOX_PROVIDER=local
MODAL_IMAGE=
MODAL_SKILLS_DIR=/root/.agents/skills
# auto (default) sandboxes local runs when the OS supports it; off never does.
SANDBOX_ISOLATION=auto
# open (default), or allowlist to allow only SANDBOX_ALLOWED_HOSTS (local sandbox).
SANDBOX_NETWORK=open
# Comma separated; *.example.com matches subdomains. Default: api.videodb.io,*.videodb.io
SANDBOX_ALLOWED_HOSTS=

# Permissions
# Highest mode a chat can pick: ask, read_only, auto or full (default full).
# Without sandbox isolation, chats default to ask and full needs DIRECTOR_ALLOW_FULL_LOCAL=1.
DIRECTOR_MAX_MODE=
DIRECTOR_ALLOW_FULL_LOCAL=
# With no client connected (scripts), calls that would ask are denied; 1 runs them.
DIRECTOR_HEADLESS_APPROVE=
# Model for Auto mode's safety check. Defaults to the chat model.
DIRECTOR_JUDGE_MODEL=

# Devzery API Test
DEVZERY_API_KEY=
DEVZERY_SOURCE_NAME=